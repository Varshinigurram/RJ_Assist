{
  // Display name for this crew
  "name": "RJ_Assist",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["academic_module_analyst", "reflective_journal_writer", "journal_quality_reviewer"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      // Task identifier
      "name": "analyze_the_provided_academic_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Analyze the supplied academic material for {subject} during {week}. Use the following academic material: {academic_material}. Also consider these college instructions: {college_instructions}. Identify only information supported by the supplied sources. Extract the important modules, topics, concepts, definitions, methods, examples, relationships, and learning points that were actually covered. For each important module or topic, identify one or more realistic practical applications that can be directly connected to the supported concepts, without inventing academic facts. Clearly distinguish source-supported information from reasonable application suggestions. Do not invent classroom activities, personal experiences, emotions, assignments, discussions, or other unsupported events. Prepare a structured academic evidence package for the journal writer.",

      // Clear definition of what the output should look like
      "expected_output": "A structured academic evidence package containing the supported subject and week information, modules or topics covered, key concepts, definitions, methods, examples, important relationships, explicitly supported class activities or observations, and realistic practical applications connected to the concepts. Clearly separate source-supported academic information from application suggestions. Do not include invented personal experiences or unsupported classroom events.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "academic_module_analyst"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "write_a_reflective_journal_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Write the final reflective journal for {subject} during {week} using the academic evidence package produced by the previous task, the journal template, college instructions, evaluation requirements, and optional student reflection. Journal template: {journal_template}. Optional student reflection: {student_reflection}. Follow exactly five sections: Experience (Class Content), Feelings (Emotional Reactions), Learning (Key Analysis), Application (Practical Use), and Conclusion. Write in simple, natural first-person undergraduate language. Use only supported academic information and supplied student reflection. Do not invent personal experiences, emotions, classroom activities, assignments, discussions, or unsupported claims. If student reflection is empty, continue without asking questions and do not fabricate personal experiences. Experience should describe supported content from the evidence package. Feelings should contain honest cognitive reflection without invented emotions. Learning should demonstrate conceptual understanding. Application must explain how a realistic practical use connects directly to relevant module concepts. Conclusion should summarize takeaways and reasonable next steps. Keep the complete journal between 200 and 400 words, with at least 50 words in every section.",

      // Clear definition of what the output should look like
      "expected_output": "A complete five-section reflective journal using exactly these sections: Experience, Feelings, Learning, Application, and Conclusion. The journal must contain 200–400 words total, with at least 50 words in every section. It must demonstrate what was learned, how the learning was experienced without fabricated personal claims, what was understood, how module concepts can be applied in realistic contexts, and the overall takeaway. The writing must be simple, natural, honest, academic, first-person where appropriate, and grounded in the supplied material and optional student reflection.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      "guardrails": [
        "The generated journal must contain exactly five sections in this order: Experience, Feelings, Learning, Application, and Conclusion.",
        "Every section must contain at least 50 words.",
        "The complete journal must contain between 200 and 400 words.",
        "The journal must not contain fabricated personal experiences, emotions, classroom activities, assignments, discussions, or other unsupported claims.",
        "The Application section must connect a realistic practical use directly to concepts from the relevant module or topic.",
        "The writing must remain simple, natural, honest, and appropriate for an undergraduate student."
      ],
      "guardrail_max_retries": 3,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "reflective_journal_writer"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    {
      // Task identifier
      "name": "review_the_generated_reflective_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Review the generated reflective journal for {subject} during {week} against the supplied academic material, journal template, college instructions, activity guidelines, and evaluation rubric. Academic material: {academic_material}. Journal template: {journal_template}. College instructions and evaluation requirements: {college_instructions}. Verify exactly five sections in this order: Experience, Feelings, Learning, Application, and Conclusion. Verify that every section contains at least 50 words and that the complete journal contains between 200 and 400 words. Evaluate Experience for accurate class content, activities, and observations supported by the sources. Evaluate Feelings for honest cognitive or emotional reflection and reject fabricated personal experiences or emotions. Evaluate Learning for accurate conceptual understanding, meaningful connections, and depth. Evaluate Application for realistic practical use that clearly explains how concepts from the relevant module or topic support that application rather than using generic statements. Evaluate Conclusion for meaningful takeaways and reasonable next steps. Also check natural undergraduate-level language, first-person reflection where appropriate, academic thoughtfulness, source relevance, repetition, generic AI-style wording, unsupported claims, invented activities, invented assignments, invented discussions, template violations, and other weaknesses. A journal may be marked PASS only when no revision is required. If any revision is needed, the verdict must be FAIL. Do not use phrases such as 'PASS with revisions', 'PASS but revise', or 'minor revisions required'. If the verdict is FAIL, provide precise revision instructions that the writer can directly follow. If the verdict is PASS, explicitly state that no further revision is required.",

      // Clear definition of what the output should look like
      "expected_output": "A structured quality assessment beginning with exactly one machine-readable verdict line: VERDICT: PASS or VERDICT: FAIL. PASS means the journal requires no further revision. FAIL means one or more revisions are required. Include section-by-section findings for Experience, Feelings, Learning, Application, and Conclusion; verified word counts for every section and the complete journal; unsupported or fabricated claims; application-to-module connection evaluation; natural undergraduate writing assessment; and precise revision instructions for every detected problem. Never use a mixed verdict such as 'PASS with revisions'.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "journal_quality_reviewer"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }

  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": false,

  // Automatically plan the execution strategy before running tasks
  // "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "academic_module_analyst",
  // "before_kickoff_callbacks": [{"python": "my_project.callbacks.before_kickoff"}],
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},

  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {
  "subject": "Data Structures",
  "week": "Week 5",
  "academic_material": "This week's module covered Binary Search Trees. The material explained that a binary search tree organizes values so that smaller values are placed in the left subtree and larger values are placed in the right subtree. The module covered insertion, deletion, searching, and tree traversal. Traversal methods included inorder, preorder, and postorder traversal. The material also explained that these operations depend on the structure of the tree and that traversal provides different ways of visiting the stored nodes.",
  "journal_template": "1. Experience (Class Content)\\n2. Feelings (Emotional Reactions)\\n3. Learning (Key Analysis)\\n4. Application (Practical Use)\\n5. Conclusion",
  "college_instructions": "The journal must demonstrate what was learned, how the learning was experienced, what was understood, and how the learning will be applied. Use first-person reflection where appropriate. Reflections should be honest, thoughtful, and academic. The total journal must contain 200–400 words. Each section should be substantial and demonstrate meaningful reflection. The Application section should explain how concepts from the relevant module can be used in practical situations. The writing should be natural and appropriate for an undergraduate student.",
  "student_reflection": ""
}
}
