{
  // Display name for this crew
  "name": "RJ_Assist",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["academic_module_analyst", "reflective_journal_writer", "journal_quality_reviewer"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      // Task identifier
      "name": "analyze_the_provided_academic_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Analyze the provided academic materials, module topics, and week information. Identify the concepts, topics, definitions, examples, methods, and learning content that are actually supported by the supplied sources. Do not invent that are not present in the available information. Prepare a clear factual summary that can be used by the reflective journal writer.",

      // Clear definition of what the output should look like
      "expected_output": "A clear source-grounded summary of the academic topics, concepts, examples, and learning content covered during the specified week, with no unsupported information.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "academic_module_analyst"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "write_a_reflective_journal_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Write a reflective journal using the analyzed academic material, supplied topics, student-provided reflection information when available, and the provided journal template and instructions. Write in simple, natural first-person language that sounds like an undergraduate college student genuinely reflecting on what was learned. Avoid unnecessarily formal vocabulary, exaggerated language, generic AI-style phrases, and repetitive sentences. Do not invent personal experiences, classroom events, assignments, discussions, or other information that is not supported by the available sources or student input. The journal must contain exactly five sections. Each section must contain at least 50 words, and the complete journal must not exceed 400 words.",

      // Clear definition of what the output should look like
      "expected_output": "A complete reflective journal following the supplied template with exactly five sections, at least 50 words in every section, and no more than 400 words in total. The writing should be simple, natural, first-person, believable undergraduate-level reflection supported by the supplied academic material and student information.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "reflective_journal_writer"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "review_the_generated_reflective_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Review the generated reflective journal carefully against the supplied template, academic material, topics, and instructions. Check that there are exactly five sections, every section contains at least 50 words, and the entire journal contains no more than 400 words. Check that the writing sounds natural, simple, personal, and appropriate for an undergraduate student. Identify unsupported claims, invented experiences, overly formal language, repetitive statements, missing information, template violations, and other issues that should be corrected before submission.",

      // Clear definition of what the output should look like
      "expected_output": "A detailed quality assessment stating whether the journal passes all requirements. If it fails, clearly identify each problem and provide specific revision instructions for the journal writer. Verify the five-section structure, minimum 50 words per section, maximum 400 words overall, template compliance, source relevance, natural undergraduate-level language, and absence of unsupported or invented information.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "journal_quality_reviewer"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }

  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": false,

  // Automatically plan the execution strategy before running tasks
  // "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "academic_module_analyst",
  // "before_kickoff_callbacks": [{"python": "my_project.callbacks.before_kickoff"}],
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},

  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {}
}
